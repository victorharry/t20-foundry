<header class="inventory-header">
	<div class="inventory-currency">
		<ul class="currency">
			<li class="currency-header" data-tooltip="{{localize 'T20.Currency'}}"><i class="fas fa-coins"></i></li>
			<li class="currency-item main" data-tooltip="Tibares (T$)">
				<label for="system.dinheiro.tp" class="denomination">T$</label>
				<input type="number" data-dtype="Number" placeholder="0" name="system.dinheiro.tp" value="{{system.dinheiro.tp}}" />
			</li>
		</ul>
	</div>
	<div class="item-controls">
		<a class="button item-control item-dialog" data-type="gerais" data-tooltip="{{localize 'T20.Add'}} {{localize 'T20.Items'}}">
			<i class="fas fa-plus"></i> {{localize 'T20.Add'}}
		</a>
	</div>
</header>
<div class="inventory-list">
	{{> "tormenta20.list-weapon"}}
	{{> "tormenta20.list-equipment"}}
	{{> "tormenta20.list-consumable"}}
	{{> "tormenta20.list-loot"}}
</div>
{{> "tormenta20.encumbrance"}}
